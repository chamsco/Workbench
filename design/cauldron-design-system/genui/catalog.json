       "additionalProperties": false
      }
     },
     "multiple": {
      "type": "boolean"
     },
     "allowText": {
      "type": "boolean"
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     }
    },
    "required": [
     "question",
     "options",
     "action"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [
    "answer"
   ],
   "notes": ""
  },
