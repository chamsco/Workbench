{
 "version": 1,
 "name": "Cauldron generative UI",
 "components": [
  {
   "name": "Stack",
   "kind": "layout",
   "summary": "Vertical or horizontal group with token gaps.",
   "useWhen": "Group blocks that belong together.",
   "props": {
    "type": "object",
    "properties": {
     "direction": {
      "enum": [
       "column",
       "row"
      ]
     },
     "gap": {
      "enum": [
       4,
       8,
       12,
       16,
       24
      ]
     },
     "wrap": {
      "type": "boolean"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "children": {
    "max": 24
   },
   "events": [],
   "notes": ""
  },
  {
   "name": "Shell",
   "kind": "layout",
   "summary": "A tray with an optional header and footer that holds one Panel.",
   "useWhen": "A standalone card in the thread or drawer: the outer layer of anything with a title.",
   "props": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 80
     },
     "subtitle": {
      "type": "string",
      "maxLength": 120
     },
     "icon": {
      "type": "string",
      "enum": [
       "check",
       "x",
       "plus",
       "up",
       "mic",
       "shield",
       "down",
       "right",
       "branch",
       "terminal",
       "file",
       "copy",
       "stop",
       "folder",
       "laptop",
       "code",
       "edit",
       "archive",
       "trash",
       "panel",
       "history",
       "split",
       "pin",
       "git",
       "search",
       "thumb-up",
       "thumb-down",
       "refresh",
       "arrow",
       "warning",
       "wrench",
       "chart",
       "message",
       "doc"
      ]
     },
     "badge": {
      "type": "string",
      "maxLength": 24
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "children": {
    "allowed": [
     "Panel",
     "Row"
    ],
    "max": 4
   },
   "events": [],
   "notes": ""
  },
  {
   "name": "Panel",
   "kind": "layout",
   "summary": "The content surface inside a Shell.",
   "useWhen": "Always inside a Shell, never inside another Panel.",
   "props": {
    "type": "object",
    "properties": {
     "padding": {
      "enum": [
       "none",
       "md"
      ]
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "children": {
    "max": 24
   },
   "events": [],
   "notes": ""
  },
  {
   "name": "Well",
   "kind": "layout",
   "summary": "An inset well for code, payloads or details.",
   "useWhen": "Show a command, a value list or output inside a Panel.",
   "props": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 2000
     },
     "mono": {
      "type": "boolean"
     }
    },
    "required": [],
    "additionalProperties": false
   },
   "children": null,
   "events": [],
   "notes": ""
  },
  {
   "name": "Text",
   "kind": "atom",
   "summary": "A run of text in a token style.",
   "useWhen": "Any prose or label that is not inside a component's own props.",
   "props": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 2000
     },
     "style": {
      "enum": [
       "body",
       "body-strong",
       "meta",
       "caption",
       "reading",
       "title",
       "mono"
      ]
     },
     "tone": {
      "enum": [
       "default",
       "muted",
       "warn",
       "bad"
      ]
     }
    },
    "required": [
     "text"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [],
   "notes": ""
  },
  {
   "name": "Button",
   "kind": "atom",
   "summary": "A button.",
   "useWhen": "One action. At most one primary per view.",
   "props": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "maxLength": 40
     },
     "variant": {
      "enum": [
       "primary",
       "secondary",
       "quiet",
       "danger"
      ]
     },
     "size": {
      "enum": [
       "md",
       "sm"
      ]
     },
     "icon": {
      "type": "string",
      "enum": [
       "check",
       "x",
       "plus",
       "up",
       "mic",
       "shield",
       "down",
       "right",
       "branch",
       "terminal",
       "file",
       "copy",
       "stop",
       "folder",
       "laptop",
       "code",
       "edit",
       "archive",
       "trash",
       "panel",
       "history",
       "split",
       "pin",
       "git",
       "search",
       "thumb-up",
       "thumb-down",
       "refresh",
       "arrow",
       "warning",
       "wrench",
       "chart",
       "message",
       "doc"
      ]
     },
     "kbd": {
      "type": "string",
      "maxLength": 12
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     },
     "disabled": {
      "type": "boolean"
     }
    },
    "required": [
     "label",
     "action"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [
    "press"
   ],
   "notes": ""
  },
  {
   "name": "IconButton",
   "kind": "atom",
   "summary": "A square icon button.",
   "useWhen": "Chrome actions whose meaning the icon carries.",
   "props": {
    "type": "object",
    "properties": {
     "icon": {
      "type": "string",
      "enum": [
       "check",
       "x",
       "plus",
       "up",
       "mic",
       "shield",
       "down",
       "right",
       "branch",
       "terminal",
       "file",
       "copy",
       "stop",
       "folder",
       "laptop",
       "code",
       "edit",
       "archive",
       "trash",
       "panel",
       "history",
       "split",
       "pin",
       "git",
       "search",
       "thumb-up",
       "thumb-down",
       "refresh",
       "arrow",
       "warning",
       "wrench",
       "chart",
       "message",
       "doc"
      ]
     },
     "label": {
      "type": "string",
      "maxLength": 40
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     },
     "pressed": {
      "type": "boolean"
     }
    },
    "required": [
     "icon",
     "label",
     "action"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [
    "press"
   ],
   "notes": ""
  },
  {
   "name": "StatusLabel",
   "kind": "atom",
   "summary": "A glyph and a word for a run or tool state.",
   "useWhen": "Any state. Colour comes from the state, never from the agent.",
   "props": {
    "type": "object",
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "running",
       "done",
       "needs-you",
       "failed",
       "stopped",
       "idle",
       "queued",
       "expiring"
      ]
     },
     "text": {
      "type": "string",
      "maxLength": 40
     },
     "elapsed": {
      "type": "string",
      "maxLength": 12
     }
    },
    "required": [
     "state"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [],
   "notes": ""
  },
  {
   "name": "Tag",
   "kind": "atom",
   "summary": "Mono label for a model, branch, file or tool; also a key hint.",
   "useWhen": "An identifier.",
   "props": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 60
     },
     "icon": {
      "type": "string",
      "enum": [
       "check",
       "x",
       "plus",
       "up",
       "mic",
       "shield",
       "down",
       "right",
       "branch",
       "terminal",
       "file",
       "copy",
       "stop",
       "folder",
       "laptop",
       "code",
       "edit",
       "archive",
       "trash",
       "panel",
       "history",
       "split",
       "pin",
       "git",
       "search",
       "thumb-up",
       "thumb-down",
       "refresh",
       "arrow",
       "warning",
       "wrench",
       "chart",
       "message",
       "doc"
      ]
     },
     "kind": {
      "enum": [
       "id",
       "key"
      ]
     }
    },
    "required": [
     "text"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [],
   "notes": ""
  },
  {
   "name": "Toggle",
   "kind": "atom",
   "summary": "On/off setting that applies immediately.",
   "useWhen": "A setting with a consequence line.",
   "props": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "maxLength": 60
     },
     "description": {
      "type": "string",
      "maxLength": 160
     },
     "value": {
      "type": "boolean"
     },
     "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     }
    },
    "required": [
     "label",
     "value",
     "action"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [
    "change"
   ],
   "notes": ""
  },
