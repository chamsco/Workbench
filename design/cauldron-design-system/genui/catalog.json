  {
   "name": "StepLedger",
   "kind": "molecule",
   "summary": "The agent's finished steps as plain lines.",
   "useWhen": "Progress of a turn that has finished or is paused.",
   "props": {
    "type": "object",
    "properties": {
     "steps": {
      "type": "array",
      "maxItems": 12,
      "items": {
       "type": "object",
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 120
        },
        "state": {
         "enum": [
          "done",
          "now",
          "todo",
          "failed"
         ]
        }
       },
       "required": [
        "text",
        "state"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "steps"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [],
   "notes": ""
  },
  {
   "name": "ThinkingTrace",
   "kind": "molecule",
   "summary": "Live rail of steps with an optional Searched row.",
   "useWhen": "A turn that is still running and takes more than a couple of seconds.",
   "props": {
    "type": "object",
    "properties": {
     "elapsed": {
      "type": "string",
      "maxLength": 12
     },
     "sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string",
         "maxLength": 40
        },
        "title": {
         "type": "string",
         "maxLength": 60
        }
       },
       "required": [
        "name"
       ],
       "additionalProperties": false
      }
     },
     "steps": {
      "type": "array",
      "maxItems": 6,
      "items": {
       "type": "string",
       "maxLength": 120
      }
     },
     "current": {
      "type": "string",
      "maxLength": 120
     }
    },
    "required": [
     "steps"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [],
   "notes": ""
  },
  {
   "name": "ToolCall",
   "kind": "molecule",
   "summary": "One tool call with state and optional input and output.",
   "useWhen": "Show a call the agent made or is making.",
   "props": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 60
     },
     "summary": {
      "type": "string",
      "maxLength": 160
     },
     "state": {
      "enum": [
       "running",
       "done",
       "failed"
      ]
     },
     "duration": {
      "type": "string",
      "maxLength": 12
     },
     "input": {
      "type": "string",
      "maxLength": 2000
     },
     "output": {
      "type": "string",
      "maxLength": 4000
     },
     "retryAction": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     }
    },
    "required": [
     "name",
     "state"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [
    "retry"
   ],
   "notes": ""
  },
  {
   "name": "ApprovalCard",
   "kind": "molecule",
   "summary": "The agent asks before an action it may not do alone.",
   "useWhen": "Any action that writes outside the worktree, spends money, pushes, deletes or messages people.",
   "props": {
    "type": "object",
    "properties": {
     "agent": {
      "type": "string",
      "maxLength": 40
     },
     "title": {
      "type": "string",
      "maxLength": 100
     },
     "why": {
      "type": "string",
      "maxLength": 300
     },
     "risk": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "details": {
      "type": "array",
      "maxItems": 6,
      "items": {
       "type": "object",
       "properties": {
        "key": {
         "type": "string",
         "maxLength": 24
        },
        "value": {
         "type": "string",
         "maxLength": 200
        }
       },
       "required": [
        "key",
        "value"
       ],
       "additionalProperties": false
      }
     },
     "approveAction": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     },
     "denyAction": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     },
     "allowAlwaysAction": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,63}$",
      "description": "An action id the host registered for this block. The agent names it; the host decides whether to run it."
     },
     "expiresIn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
     }
    },
    "required": [
     "title",
     "why",
     "risk",
     "approveAction",
     "denyAction"
    ],
    "additionalProperties": false
   },
   "children": null,
   "events": [
    "approve",
    "deny",
    "allow-always"
   ],
   "notes": "The host runs the action. The agent can never approve its own card."
  },
  {
   "name": "AgentQuestion",
   "kind": "molecule",
   "summary": "The agent asks the person a question with choices or free text.",
